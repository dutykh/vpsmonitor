# Website Monitor Configuration
# Author: Dr. Denys Dutykh (Khalifa University of Science and Technology, Abu Dhabi, UAE)
#
# Copy this file to .env and update with your values:
#   cp .env.example .env && chmod 600 .env
#
# NEVER commit .env - it contains credentials. It is covered by .gitignore.

# ---------------------------------------------------------------------------
# Messages: where each kind goes
# ---------------------------------------------------------------------------
# Each kind of message has a route: email, command (MESSAGE_COMMAND below),
# both (email,command), or none. Empty means email.
#   ROUTE_DOWN      outage alerts and their reminders, flapping notices
#   ROUTE_RESOLVED  recovery notices, and notices that a target is steady again
#   ROUTE_TLS       certificate expiry warnings
#   ROUTE_SUMMARY   daily, weekly and monthly summaries (--report)
#   ROUTE_NOTIFY    messages handed over by other scripts (--notify), such as
#                   the security watchdog's
# Mail settings are needed only when a route names email.
ROUTE_DOWN=email
ROUTE_RESOLVED=email
ROUTE_TLS=email
ROUTE_SUMMARY=email
ROUTE_NOTIFY=email

# The command of the "command" channel: run without a shell, the body on its
# standard input. In each argument {subject} is the subject, {kind} the kind of
# message (down, resolved, tls, flap, steady, summary, notify, test, broken)
# and {level} its weight (error, warn, success, info). For example, with
# tg-ping (https://github.com/dutykh/tg-ping), naming the program by its
# absolute path, since no shell expands ~ or $HOME:
# MESSAGE_COMMAND=/home/user/tools/tg-ping/bin/tg-ping --level {level} --title {subject}

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
SMTP_SERVER=mail.example.org
SMTP_PORT=587

# starttls (port 587, default) | ssl (implicit TLS, port 465) | plain (no TLS, testing only)
SMTP_SECURITY=starttls

# The login is also the address the alerts are sent from, unless SMTP_FROM says
# otherwise, so use the full address of an account that exists on the mail
# server. Nobody has to read its mailbox. Leave both empty for a server that
# takes mail without a login, such as a local relay on port 25.
SMTP_USERNAME=vpsmonitor@example.org
SMTP_PASSWORD=a-long-random-password

# The sender address, when it is not the login (a provider whose login is an
# API key), or when there is no login at all.
# SMTP_FROM=vpsmonitor@example.org

# Where alerts are delivered. Comma-separated for multiple recipients.
ALERT_EMAIL=alerts@example.net

# Seconds to wait on the SMTP server before giving up (0 = no timeout, not recommended)
SMTP_TIMEOUT=30

# Spare route when no channel of a message's route could deliver it (empty =
# none). Same syntax and placeholders as MESSAGE_COMMAND. Not used for the test
# messages and the summaries.
# FALLBACK_COMMAND=/home/user/tools/tg-ping/bin/tg-ping --warn --title {subject}

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
# Websites to monitor (comma-separated)
WEBSITES=https://example.com,https://www.example.com

# API endpoints (semicolon-separated)
# Format: name|url|expected_status|expected_response_key:value,key2:value2
# Examples:
#   API_ENDPOINTS=MyAPI|http://127.0.0.1:8000/api/v1/health|200
#   API_ENDPOINTS=MyAPI|http://127.0.0.1:8000/api/v1/health|200|status:healthy,database:connected
#   API_ENDPOINTS=API1|http://127.0.0.1:8000/health|200|status:ok;API2|http://127.0.0.1:8001/status|200
API_ENDPOINTS=

# Optional: for richer per-target options (content checks, custom headers, methods,
# per-target thresholds), create targets.toml instead. See targets.toml.example.
# If targets.toml exists it takes precedence over WEBSITES / API_ENDPOINTS above.
# TARGETS_FILE=targets.toml

# ---------------------------------------------------------------------------
# Check behaviour
# ---------------------------------------------------------------------------
TIMEOUT=30              # Per-request timeout in seconds
MAX_RETRIES=3           # Attempts per target before declaring it down
MAX_WORKERS=8           # Parallel checks (1 = sequential)
# Seconds between passes: the cadence of --continuous mode, and under cron or a
# timer what the summaries expect (three missed passes, and at least half an
# hour, and a summary says the monitor itself has stopped).
CHECK_INTERVAL=300

# Flag a target in the summaries when its p95 response time over the period
# exceeds this many milliseconds. Empty or 0 disables.
SLOW_THRESHOLD_MS=

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Delay before the FIRST re-alert on an ongoing incident; it sets the scale of
# the whole ladder, whose gaps are 1, 2, 4, 8, 12 and 24 times ALERT_COOLDOWN/1h
# (with the default: +1h, +3h, +7h, +15h, +27h, +51h, then daily). The initial
# DOWN alert is immediate, and a RESOLVED message follows every announced outage.
ALERT_COOLDOWN=3600

# true: one message per pass for all the targets that failed, listed site by
# site (a site is the host without www., so example.com and www.example.com
# appear together). false: one message per target.
GROUP_ALERTS=true

# Consecutive failed passes before alerting (1 = alert on first failed pass;
# each pass already performs MAX_RETRIES attempts internally). 2 keeps quiet
# about a single failed pass, such as the few seconds of a restart, at the cost
# of announcing a real outage one pass later; the outage is still dated from
# its first failed check.
FAILURE_THRESHOLD=1

# Flapping: a target whose last FLAP_WINDOW checks hold FLAP_CHANGES changes of
# state or more is flapping. One message says so; while it flaps, an outage of
# it is announced only once it has lasted FLAP_HOLD seconds, and a message says
# when it has kept one state through FLAP_WINDOW checks. FLAP_CHANGES=0 turns
# this off.
FLAP_CHANGES=6
FLAP_WINDOW=12
FLAP_HOLD=900

# ---------------------------------------------------------------------------
# TLS certificate expiry monitoring
# ---------------------------------------------------------------------------
SSL_CHECK_ENABLED=true
SSL_WARN_DAYS=21,14,7,3,1

# ---------------------------------------------------------------------------
# Dead-man's switch
# ---------------------------------------------------------------------------
# Ping this URL after every successful run. If the VPS or cron dies, the remote
# service notices the missing ping and alerts you. Works with healthchecks.io,
# Uptime Kuma push monitors, cronitor, etc. Leave empty to disable.
HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Logging & retention
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
LOG_RETENTION_DAYS=90   # Daily logs kept uncompressed; older are gzipped
LOG_ARCHIVE_DAYS=365    # Gzipped logs deleted after this many days
DB_RETENTION_DAYS=90    # Raw check rows kept; older rolled up into daily aggregates

# Optional: override the User-Agent sent with every request
# USER_AGENT=Website-Monitor/2.0
