# Website Monitor Configuration
# Author: Dr. Denys Dutykh (Khalifa University of Science and Technology, Abu Dhabi, UAE)
#
# Copy this file to .env and update with your values:
#   cp .env.example .env && chmod 600 .env
#
# NEVER commit .env - it contains credentials. It is covered by .gitignore.

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# starttls (port 587, default) | ssl (implicit TLS, port 465) | plain (no TLS, testing only)
SMTP_SECURITY=starttls

# For Gmail, use an app-specific password:
#   https://support.google.com/accounts/answer/185833
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-specific-password

# Where alerts are delivered. Comma-separated for multiple recipients.
ALERT_EMAIL=alerts@example.com

# Seconds to wait on the SMTP server before giving up (0 = no timeout, not recommended)
SMTP_TIMEOUT=30

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
# Websites to monitor (comma-separated)
WEBSITES=https://example.com,https://www.example.com

# API endpoints (semicolon-separated)
# Format: name|url|expected_status|expected_response_key:value,key2:value2
# Examples:
#   API_ENDPOINTS=MyAPI|http://127.0.0.1:8000/api/v1/health|200
#   API_ENDPOINTS=MyAPI|http://127.0.0.1:8000/api/v1/health|200|status:healthy,database:connected
#   API_ENDPOINTS=API1|http://127.0.0.1:8000/health|200|status:ok;API2|http://127.0.0.1:8001/status|200
API_ENDPOINTS=

# Optional: for richer per-target options (content checks, custom headers, methods,
# per-target thresholds), create targets.toml instead. See targets.toml.example.
# If targets.toml exists it takes precedence over WEBSITES / API_ENDPOINTS above.
# TARGETS_FILE=targets.toml

# ---------------------------------------------------------------------------
# Check behaviour
# ---------------------------------------------------------------------------
TIMEOUT=30              # Per-request timeout in seconds
MAX_RETRIES=3           # Attempts per target before declaring it down
MAX_WORKERS=8           # Parallel checks (1 = sequential)
CHECK_INTERVAL=900      # Seconds between passes in --continuous mode (ignored under cron)

# Warn when a target's 24h p95 latency exceeds this. Empty or 0 disables.
SLOW_THRESHOLD_MS=

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Delay before the FIRST re-alert on an ongoing incident. Subsequent re-alerts
# escalate: 1x, 2x, 4x, 8x, then every 24h. The initial DOWN alert is immediate,
# and a RESOLVED email is always sent when a target recovers.
ALERT_COOLDOWN=3600

# Group apex + www (and other same-domain targets) into a single email per incident
GROUP_ALERTS=true

# Consecutive failed passes before alerting (1 = alert on first failed pass;
# each pass already performs MAX_RETRIES attempts internally)
FAILURE_THRESHOLD=1

# ---------------------------------------------------------------------------
# TLS certificate expiry monitoring
# ---------------------------------------------------------------------------
SSL_CHECK_ENABLED=true
SSL_WARN_DAYS=21,14,7,3,1

# ---------------------------------------------------------------------------
# Dead-man's switch
# ---------------------------------------------------------------------------
# Ping this URL after every successful run. If the VPS or cron dies, the remote
# service notices the missing ping and alerts you. Works with healthchecks.io,
# Uptime Kuma push monitors, cronitor, etc. Leave empty to disable.
HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Logging & retention
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
LOG_RETENTION_DAYS=90   # Daily logs kept uncompressed; older are gzipped
LOG_ARCHIVE_DAYS=365    # Gzipped logs deleted after this many days
DB_RETENTION_DAYS=90    # Raw check rows kept; older rolled up into daily aggregates

# Optional: override the User-Agent sent with every request
# USER_AGENT=Website-Monitor/2.0
